# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不会入库
# 变量前缀统一为 AI_（见 app/core/config.py）

# 内部调用令牌：必须与 Java 侧 app.ai.internal-token 完全一致
AI_INTERNAL_TOKEN=change-me

# 通道：fake 返回假数据流（不花钱，先跑通链路）；deepseek 调用真实模型
AI_PROVIDER=fake

# DeepSeek（OpenAI 兼容协议），provider=deepseek 时必填
# 此处只能写占位符，真实 key 只放 .env（已 gitignore），切勿提交
AI_DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_DEEPSEEK_MODEL=deepseek-chat

# 单次请求超时（秒），需小于 Java 侧 stream-timeout
AI_REQUEST_TIMEOUT=120

# 上下文最多携带的历史消息条数
AI_MAX_HISTORY=20